# PetSnap Mobile App - Environment Configuration Example
# Copy this file to .env and update with your actual values

# API Configuration
# Replace with your computer's local IP address (find with ipconfig on Windows or ifconfig on Mac/Linux)
# Example: API_BASE_URL=http://192.168.1.100:8000
API_BASE_URL=http://localhost:8000

# API Key - Must match the key in your FastAPI server
API_KEY=KWkKo1HmrQ3UWm9SvhOk3g8OgT4qcEPX

# App Configuration
MAX_IMAGE_SIZE=10485760  # 10MB in bytes
IMAGE_QUALITY=0.8        # 0.0 to 1.0
